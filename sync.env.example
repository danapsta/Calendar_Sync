# Copy to sync.env and edit values as needed.
# Lines starting with # are ignored. You can also use `export KEY=VALUE`.

# Core sync timing & window
SYNC_POLL_SECONDS=60
SYNC_LOOKBACK_DAYS=365
SYNC_LOOKAHEAD_DAYS=365

# Target Google calendar
GOOGLE_CALENDAR_ID=primary

# Local sync state database
SYNC_DB_PATH=sync_state.sqlite3

# Persistent tag used in Google extendedProperties
SYNC_TAG_VALUE=outlook-google-sync

# Category/color sync mapping (JSON dicts)
# OUTLOOK_CATEGORY_COLOR_MAP={"Work Appointments":"5","Personal":"2"}
# GCAL_COLOR_OUTLOOK_CATEGORY_MAP={"5":"Work Appointments","2":"Personal"}

# Default Google colorId if no category match
# DEFAULT_GCAL_COLOR_ID=5

# Dedupe options
DEDUPE_ON_START=0
DEDUPE_DRY_RUN=0
DEDUPE_SLEEP_BETWEEN_DELETES_S=0.2
DEDUPE_MAX_RESULTS=2500

# Optional: print htmlLink on create/patch
GOOGLE_UPSERT_DEBUG=0
